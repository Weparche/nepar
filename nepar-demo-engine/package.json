{
  "name": "nepar-demo-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types src/worker-configuration.d.ts --env-file .dev.vars.example",
    "check:types": "wrangler types src/worker-configuration.d.ts --env-file .dev.vars.example --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "tsx scripts/generate.ts",
    "qa": "tsx scripts/qa.ts",
    "qa:dashboard": "tsx scripts/dashboard-qa.ts",
    "verify": "npm run check:types && npm run typecheck && npm test && npm run deploy -- --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.125.0"
  }
}
